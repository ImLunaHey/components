{
  "name": "luna-components",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "turbo run dev",
    "build": "turbo run build",
    "test": "pnpm build:preview && vitest run --config vitest.config.ts",
    "lint": "oxlint -c oxlint.config.ts . && node scripts/component-boundary.mjs",
    "build:preview": "node build.mjs",
    "test:packages": "turbo run test",
    "check": "pnpm typecheck && pnpm lint && pnpm build && pnpm test && pnpm test:packages && pnpm test:apps && pnpm test:e2e",
    "format": "oxfmt --write .",
    "format:check": "oxfmt --check .",
    "test:apps": "node scripts/smoke-apps.mjs",
    "typecheck": "turbo run build --filter=@imlunahey/components && tsc -p tsconfig.json",
    "test:e2e": "playwright test"
  },
  "dependencies": {
    "@imlunahey/components": "workspace:*",
    "@pierre/diffs": "^1.7.1",
    "@pierre/highlights": "^0.5.2",
    "@pierre/trees": "^1.0.0",
    "@pierre/words": "^0.3.0",
    "@stylexjs/stylex": "^0.19.2",
    "@tanstack/charts": "^1.5.0",
    "@tanstack/react-router": "^1.170.46",
    "@tanstack/react-table": "^8.21.3",
    "@tanstack/table-core": "^8.21.3",
    "@tanstack/virtual-core": "^3.19.13",
    "country-flag-icons": "^1.6.20",
    "dompurify": "^3.5.0",
    "lucide-react": "^1.78.0",
    "papaparse": "^5.7.1",
    "qrcode": "^1.5.4",
    "react": "^19.3.1",
    "react-dom": "^19.3.1"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.14.0",
    "@changesets/cli": "^3.0.3",
    "@imlunahey/oxlint-config": "0.1.0",
    "@napi-rs/canvas": "^1.2.0",
    "@playwright/test": "^1.65.1",
    "@stylexjs/unplugin": "^0.19.2",
    "@testing-library/jest-dom": "^8.0.0",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.13",
    "@types/papaparse": "^5.5.2",
    "@types/qrcode": "^1.5.6",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.3.0",
    "esbuild": "^0.28.2",
    "jsdom": "^31.0.1",
    "oxfmt": "0.80.0",
    "oxlint": "1.95.0",
    "oxlint-plugin-react-doctor": "0.9.23",
    "turbo": "2.11.13",
    "typescript": "^7.0.2",
    "vite": "^8.3.8",
    "vitest": "^5.1.1"
  },
  "packageManager": "pnpm@12.18.0"
}
