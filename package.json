{
  "name": "luna-components",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "turbo run dev",
    "build": "turbo run build",
    "test": "pnpm build:preview && node --test tests/*.test.mjs",
    "lint": "oxlint -c oxlint.config.ts . && node scripts/component-boundary.mjs",
    "build:preview": "node build.mjs",
    "test:packages": "turbo run test",
    "check": "pnpm typecheck && pnpm lint && pnpm build && pnpm test && pnpm test:packages && pnpm test:apps",
    "format": "oxfmt --write .",
    "format:check": "oxfmt --check .",
    "test:apps": "node scripts/smoke-apps.mjs",
    "typecheck": "tsc -p tsconfig.json"
  },
  "dependencies": {
    "@pierre/diffs": "^1.7.1",
    "@pierre/highlights": "^0.5.2",
    "@pierre/trees": "^1.0.0",
    "@pierre/words": "^0.3.0",
    "@tanstack/charts": "^1.5.0",
    "@tanstack/table-core": "^8.21.3",
    "@tanstack/virtual-core": "^3.19.13",
    "dompurify": "^3.5.0",
    "papaparse": "^5.7.1",
    "qrcode": "^1.5.4"
  },
  "devDependencies": {
    "@changesets/cli": "^3.0.3",
    "@imlunahey/oxlint-config": "file:vendor/imlunahey-oxlint-config-0.1.0.tgz",
    "@napi-rs/canvas": "^1.2.0",
    "esbuild": "^0.25.12",
    "jsdom": "^31.0.1",
    "oxfmt": "0.80.0",
    "oxlint": "1.95.0",
    "turbo": "2.11.13",
    "typescript": "^7.0.2"
  },
  "packageManager": "pnpm@12.18.0"
}
