{
  "$schema": "https://turborepo.com/schema.json",
  "globalDependencies": [
    "design/*.css",
    "design/assets/examples/**",
    "build.mjs",
    "build-demos.mjs",
    "scripts/**",
    "src/**",
    "packages/components/src/**"
  ],
  "tasks": {
    "build": { "dependsOn": ["^build"], "outputs": ["dist/**"] },
    "dev": { "dependsOn": ["build"], "cache": false, "persistent": true },
    "test": { "dependsOn": ["build"], "outputs": [] }
  }
}
